VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
OPENAI_API_KEY=

# Server-only — bypasses RLS, used by api/midtrans/*.ts to write payment_transactions
# and subscription_status. Never expose to the frontend.
SUPABASE_SERVICE_ROLE_KEY=

# Midtrans Sandbox. Server key stays server-only; client key is meant to be public
# (Snap.js loads it in the browser) — see src/shared/lib/midtransSnap.ts.
MIDTRANS_SERVER_KEY=
VITE_MIDTRANS_CLIENT_KEY=
